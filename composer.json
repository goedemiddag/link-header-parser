{
    "name": "goedemiddag/link-header-parser",
    "description": "Package for parsing the Link HTTP header",
    "homepage": "https://github.com/goedemiddag/link-header-parser",
    "license": "MIT",
    "authors": [
        {
            "name": "Dick van der Heiden",
            "email": "dick@goedemiddag.nl"
        }
    ],
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "laravel/pint": "^1.29",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Goedemiddag\\LinkHeaderParser\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Goedemiddag\\LinkHeaderParser\\Tests\\": "tests"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "code-style:check": "vendor/bin/pint --test",
        "code-style:fix": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/phpunit",
        "test:no-coverage": "vendor/bin/phpunit --no-coverage"
    }
}
